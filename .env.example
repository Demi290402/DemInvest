# ==============================================================================
# DEMINVEST — CONFIGURAZIONE AMBIENTE (.env.example)
# ==============================================================================
# Copia questo file in `.env` per configurare l'ambiente locale o cloud.
# IMPORTANTE:
# - Le variabili con prefisso `VITE_` sono visibili al client (solo endpoint pubblici).
# - Tutte le API Key dei provider dati, AI e la chiave privata VAPID NON hanno
#   il prefisso `VITE_` e vengono lette ESCLUSIVAMENTE dal backend server /
#   Supabase Edge Functions. Non inserire mai segreti in variabili `VITE_`.
# ==============================================================================

# --- 1. SUPABASE (Database, Auth & Edge Functions) ---
# Ottieni URL e Anon/Publishable Key dalla dashboard del tuo progetto Supabase:
# Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-backend-only

# --- 2. MODALITÀ ACCESSO PRIVATO ---
# Se impostato a true, consente la registrazione esclusivamente del primo
# proprietario dell'istanza e blocca qualsiasi registrazione pubblica successiva.
SINGLE_USER_MODE=true

# --- 3. MARKET DATA PROVIDERS (Lette esclusivamente dal Backend) ---
# CoinGecko API (https://www.coingecko.com/en/api)
# Opzionale per chiamate pubbliche base con rate-limit; consigliata Demo o Pro Key.
COINGECKO_API_KEY=

# Twelve Data API (https://twelvedata.com/)
# Usata per Azioni, ETF, Indici e Forex. Se assente, usa la modalità sandbox ufficiale
# solo per i simboli dimostrativi autorizzati da Twelve Data (es. AAPL, EUR/USD).
TWELVE_DATA_API_KEY=

# Alpha Vantage API (https://www.alphavantage.co/support/#api-key)
# Provider secondario per Azioni, Forex, Serie Storiche e News verificate.
ALPHA_VANTAGE_API_KEY=

# FRED API — Federal Reserve Bank of St. Louis (https://fred.stlouisfed.org/docs/api/api_key.html)
# Usata per indicatori macroeconomici ufficiali (Inflazione CPI, Fed Funds Rate, PIL, Disoccupazione).
FRED_API_KEY=

# --- 4. DEMINVEST AI ENGINE (Letta esclusivamente dal Backend) ---
# Google Gemini API Key (https://aistudio.google.com/app/apikey)
# Se non configurata, DemInvest AI opera in Modalità Deterministica Tool-Based verificata.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 5. WEB PUSH NOTIFICATIONS (Protocollo VAPID RFC 8292) ---
# Genera una coppia di chiavi con: npx web-push generate-vapid-keys
# La chiave pubblica può essere condivisa con il Service Worker; la privata resta sul backend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@deminvest.local

# --- 6. SCHEDULER E BUDGET CHIAMATE API ---
# Limite massimo giornaliero di chiamate esterne per proteggere i piani API
DAILY_API_CALL_BUDGET=500
SCHEDULER_CRON_SECRET=replace-with-random-high-entropy-secret
